{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "grammar-hall-index",
  "title": "语法大厅索引",
  "description": "data/grammar/index.json 的结构。只存元信息（供大厅列表页渲染），不存正文与题目。加一课时：写 gXX.json，然后往 lessons 里追加一条，并把该文件登记进 sw.js 无需——内容文件走运行时缓存，只有 index.json 在预缓存清单里。",
  "type": "object",
  "required": ["type", "version", "tiers", "lessons"],
  "properties": {
    "type": { "const": "grammar-hall" },
    "version": { "type": "string", "description": "内容版本，与 sw.js 的 CACHE_VERSION 同步递增" },
    "updated": { "type": "string", "description": "YYYY-MM-DD" },
    "tiers": {
      "type": "array",
      "description": "四个分层：基石/骨架/进阶/精修",
      "items": {
        "type": "object",
        "required": ["key", "name", "range"],
        "properties": {
          "key": { "enum": ["foundation", "skeleton", "advanced", "polish"] },
          "name": { "enum": ["基石", "骨架", "进阶", "精修"] },
          "range": { "type": "string", "description": "如 G01-G12" },
          "stage": { "type": "string", "description": "对应学段，如 小学1-4年级" },
          "cefr": { "type": "string" },
          "color": { "type": "string", "description": "分层主题色 #RRGGBB" }
        }
      }
    },
    "lessons": {
      "type": "array",
      "description": "50 课的元信息。顺序即展示顺序。",
      "items": {
        "type": "object",
        "required": ["id", "tier", "title", "metaphor", "ketRelevance", "ketLessonMap", "file", "questionCount", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^G[0-9]{2}$", "description": "课号 G01-G50" },
          "tier": { "enum": ["基石", "骨架", "进阶", "精修"] },
          "title": { "type": "string", "description": "课题，如 冠词 a/an/the" },
          "metaphor": { "type": "string", "description": "乐队比喻锚点一句话，如 「a 的前世是 one（新朋友），the 的前世是 that（老朋友）」" },
          "ketRelevance": { "type": "integer", "minimum": 0, "maximum": 3, "description": "KET 相关度星级 0-3，0 = KET 不考" },
          "ketLessonMap": {
            "type": ["array", "null"],
            "description": "对应 KET 备考中心「语法八课」的课号数组，如 [\"L6\"]；不对应任何一课则为 null。用于双向跳转（P2 单元 X）。",
            "items": { "type": "string", "pattern": "^L[1-8]$" }
          },
          "file": { "type": "string", "description": "相对项目根的正文路径，如 ./data/grammar/g02.json" },
          "questionCount": { "type": "integer", "description": "该课练习题总数，规格为 64（4 环节 × 16 题），侦探关另计" },
          "status": { "enum": ["planned", "draft", "done"], "description": "planned=占位未写，draft=写了但未过校验，done=已验收" }
        }
      }
    }
  }
}
