{
  "level": "kindergarten",
  "topics": [
    {
      "id": "gk-001",
      "title": "I am ... 我是...",
      "grade": [1, 2],
      "summary": "用 I am 介绍自己。",
      "rules": [
        "I 后面用 am",
        "可以说 I am + 名字 / I am + 数字(年龄) / I am + 形容词",
        "缩写：I am = I'm"
      ],
      "examples": [
        {"en": "I am Tom.", "zh": "我是汤姆。"},
        {"en": "I am six.", "zh": "我六岁。"},
        {"en": "I am happy.", "zh": "我很开心。"}
      ],
      "quiz": [
        {"question": "I ___ Tom.", "options": ["am", "is", "are", "be"], "answer": 0, "explanation": "I 后面用 am。"},
        {"question": "I ___ a boy.", "options": ["am", "is", "are", "be"], "answer": 0, "explanation": "I 后面用 am。"},
        {"question": "I ___ seven.", "options": ["am", "is", "are", "be"], "answer": 0, "explanation": "I 后面用 am。"},
        {"question": "选出正确的: I am ___.", "options": ["happy", "are happy", "is happy", "be happy"], "answer": 0, "explanation": "I am 后面直接加形容词或名词。"},
        {"question": "I am Tom. = ___ Tom.", "options": ["I'm", "Im", "I are", "Im a"], "answer": 0, "explanation": "I am 的缩写是 I'm，注意有撇号。"}
      ]
    },
    {
      "id": "gk-002",
      "title": "It is a ... 这是一个...",
      "grade": [1, 2],
      "summary": "用 It is a/an 介绍一个东西。",
      "rules": [
        "It 后面用 is",
        "It is a/an + 名词",
        "辅音开头用 a，元音开头用 an",
        "缩写：It is = It's"
      ],
      "examples": [
        {"en": "It is a cat.", "zh": "这是一只猫。"},
        {"en": "It is an apple.", "zh": "这是一个苹果。"},
        {"en": "It is red.", "zh": "它是红色的。"}
      ],
      "quiz": [
        {"question": "It ___ a dog.", "options": ["am", "is", "are", "be"], "answer": 1, "explanation": "It 后面用 is。"},
        {"question": "It is ___ apple.", "options": ["a", "an", "the", "/"], "answer": 1, "explanation": "apple 以元音 a 开头，用 an。"},
        {"question": "It is ___ cat.", "options": ["a", "an", "the", "/"], "answer": 0, "explanation": "cat 以辅音 c 开头，用 a。"},
        {"question": "It is = ___", "options": ["It's", "Its", "It is'", "It s"], "answer": 0, "explanation": "It is 的缩写是 It's。"},
        {"question": "选出正确的句子", "options": ["It is a egg.", "It is an egg.", "It a egg.", "It an egg."], "answer": 1, "explanation": "egg 以元音 e 开头，用 an；句子要有 is。"}
      ]
    },
    {
      "id": "gk-003",
      "title": "I have ... 我有...",
      "grade": [1, 2],
      "summary": "用 I have 表示我拥有某样东西。",
      "rules": [
        "I have + 名词",
        "一个用 a/an，多个用复数(后面加 s)",
        "I 后面用 have，不是 has"
      ],
      "examples": [
        {"en": "I have a pen.", "zh": "我有一支笔。"},
        {"en": "I have two cats.", "zh": "我有两只猫。"},
        {"en": "I have a red ball.", "zh": "我有一个红球。"}
      ],
      "quiz": [
        {"question": "I ___ a book.", "options": ["have", "has", "is", "am"], "answer": 0, "explanation": "I 后面用 have。"},
        {"question": "I have ___ apple.", "options": ["a", "an", "two", "are"], "answer": 1, "explanation": "apple 元音开头，用 an。"},
        {"question": "I have two ___.", "options": ["cat", "cats", "a cat", "is cat"], "answer": 1, "explanation": "two 后面用复数，cat 加 s 变 cats。"},
        {"question": "选出正确的句子", "options": ["I has a dog.", "I have a dog.", "I am a dog.", "I is a dog."], "answer": 1, "explanation": "I 后面用 have。"},
        {"question": "I have ___ pencils.", "options": ["a", "an", "five", "is"], "answer": 2, "explanation": "pencils 是复数，前面用数字。"}
      ]
    },
    {
      "id": "gk-004",
      "title": "I like ... 我喜欢...",
      "grade": [1, 2],
      "summary": "用 I like 表示我喜欢什么。",
      "rules": [
        "I like + 名词(单数或复数)",
        "喜欢一类东西用复数: I like apples.",
        "I don't like = 我不喜欢"
      ],
      "examples": [
        {"en": "I like apples.", "zh": "我喜欢苹果。"},
        {"en": "I like dogs.", "zh": "我喜欢狗。"},
        {"en": "I don't like milk.", "zh": "我不喜欢牛奶。"}
      ],
      "quiz": [
        {"question": "I ___ cats.", "options": ["like", "likes", "is", "am"], "answer": 0, "explanation": "I 后面用 like。"},
        {"question": "I like ___.", "options": ["apple", "apples", "a apple", "is apple"], "answer": 1, "explanation": "喜欢一类水果用复数 apples。"},
        {"question": "我不喜欢 = I ___ like.", "options": ["am not", "don't", "no", "not"], "answer": 1, "explanation": "「我不喜欢」用 I don't like。"},
        {"question": "I like ___.", "options": ["sing", "sings", "singing", "sang"], "answer": 2, "explanation": "like 后面接 -ing 形式表示喜欢做某事：I like singing。"},
        {"question": "选出错误的句子", "options": ["I like cats.", "I like fish.", "I likes dogs.", "I like apples."], "answer": 2, "explanation": "I 后面用 like，不是 likes。"}
      ]
    },
    {
      "id": "gk-005",
      "title": "I can ... 我会...",
      "grade": [1, 2],
      "summary": "用 I can 表示我能/会做某事。",
      "rules": [
        "I can + 动词原形",
        "can 表示有能力做某事",
        "I can't = I cannot = 我不能"
      ],
      "examples": [
        {"en": "I can run.", "zh": "我会跑。"},
        {"en": "I can sing.", "zh": "我会唱歌。"},
        {"en": "I can't fly.", "zh": "我不会飞。"}
      ],
      "quiz": [
        {"question": "I can ___.", "options": ["run", "runs", "running", "ran"], "answer": 0, "explanation": "can 后面用动词原形。"},
        {"question": "I ___ sing.", "options": ["can", "cans", "is", "am can"], "answer": 0, "explanation": "can 没有变化形式。"},
        {"question": "我不能 = I ___", "options": ["can not", "can't", "no can", "don't can"], "answer": 1, "explanation": "「我不能」用 I can't。"},
        {"question": "选正确的句子", "options": ["I can sings.", "I can sing.", "I can singing.", "I cans sing."], "answer": 1, "explanation": "can 后接动词原形 sing。"},
        {"question": "I can ___ a kite.", "options": ["fly", "flies", "flying", "flew"], "answer": 0, "explanation": "can 后面用动词原形 fly。"}
      ]
    },
    {
      "id": "gk-006",
      "title": "This is ... 这是...",
      "grade": [1, 2],
      "summary": "用 This is 介绍近处的人或物。",
      "rules": [
        "This is + 人/物",
        "可以介绍家人、朋友、东西",
        "This is = 这是(近处)"
      ],
      "examples": [
        {"en": "This is my mom.", "zh": "这是我妈妈。"},
        {"en": "This is my book.", "zh": "这是我的书。"},
        {"en": "This is Tom.", "zh": "这是汤姆。"}
      ],
      "quiz": [
        {"question": "This ___ Tom.", "options": ["am", "is", "are", "be"], "answer": 1, "explanation": "This 后面用 is。"},
        {"question": "___ is my dad.", "options": ["This", "I", "You", "Are"], "answer": 0, "explanation": "介绍近处的人用 This。"},
        {"question": "This is ___ pen.", "options": ["I", "me", "my", "are"], "answer": 2, "explanation": "我的用 my。"},
        {"question": "选出正确的句子", "options": ["This is mom my.", "This is my mom.", "This my is mom.", "This are my mom."], "answer": 1, "explanation": "正确语序是 This is my mom。"},
        {"question": "介绍近处的东西，用哪个开头？", "options": ["This is", "That is", "It am", "You is"], "answer": 0, "explanation": "近处用 This is；That is 用来说远处的东西。"}
      ]
    },
    {
      "id": "gk-007",
      "title": "复数: 一个和很多个",
      "grade": [1, 2],
      "summary": "一个东西用 a/an，多个要在名词后加 s。",
      "rules": [
        "一个：a cat / a dog / an apple",
        "两个或更多：two cats / three dogs / many apples",
        "名词后加 -s 变复数",
        "辅音开头用 a，元音开头用 an"
      ],
      "examples": [
        {"en": "a cat", "zh": "一只猫"},
        {"en": "two cats", "zh": "两只猫"},
        {"en": "three apples", "zh": "三个苹果"}
      ],
      "quiz": [
        {"question": "I have a ___.", "options": ["cat", "cats", "two cat", "an cat"], "answer": 0, "explanation": "a 后面用单数 cat。"},
        {"question": "Two ___.", "options": ["dog", "dogs", "a dog", "an dog"], "answer": 1, "explanation": "two 后面用复数 dogs。"},
        {"question": "Three ___.", "options": ["apple", "apples", "a apple", "an apple"], "answer": 1, "explanation": "three 后面用复数 apples。"},
        {"question": "I see ___ bird.", "options": ["a", "an", "two", "many"], "answer": 0, "explanation": "bird 单数辅音开头用 a。"},
        {"question": "I see ___ egg.", "options": ["a", "an", "two egg", "many egg"], "answer": 1, "explanation": "egg 元音开头用 an。"}
      ]
    },
    {
      "id": "gk-008",
      "title": "颜色描述: The X is + 颜色",
      "grade": [1, 2],
      "summary": "用 The X is + 颜色 来描述东西的颜色。",
      "rules": [
        "结构：The + 名词 + is + 颜色",
        "The apple is red. = 苹果是红色的",
        "也可以说：It is red.",
        "颜色词放在 is 后面"
      ],
      "examples": [
        {"en": "The apple is red.", "zh": "苹果是红色的。"},
        {"en": "The sky is blue.", "zh": "天是蓝色的。"},
        {"en": "The cat is black.", "zh": "猫是黑色的。"}
      ],
      "quiz": [
        {"question": "The apple ___ red.", "options": ["am", "is", "are", "be"], "answer": 1, "explanation": "The apple 是单数，用 is。"},
        {"question": "The sky is ___.", "options": ["blue", "a blue", "blues", "is blue"], "answer": 0, "explanation": "is 后面直接加颜色词。"},
        {"question": "选出正确的句子", "options": ["The cat is black.", "The cat black.", "The cat are black.", "Cat is black the."], "answer": 0, "explanation": "正确语序: The + 名词 + is + 颜色。"},
        {"question": "___ is yellow.", "options": ["The sun", "Sun the", "Sun is", "The is sun"], "answer": 0, "explanation": "主语是 The sun。"},
        {"question": "The grape is ___.", "options": ["a purple", "purple", "purples", "is purple"], "answer": 1, "explanation": "is 后直接加颜色 purple。"}
      ]
    },
    {
      "id": "gk-009",
      "title": "How many...? 数数",
      "grade": [1, 2],
      "summary": "用 How many 问数量，回答用数字+复数名词。",
      "rules": [
        "结构：How many + 复数名词？",
        "How many apples? = 多少个苹果？",
        "回答：数字 + 复数名词",
        "Five apples. = 五个苹果"
      ],
      "examples": [
        {"en": "How many apples?", "zh": "多少个苹果？"},
        {"en": "Five apples.", "zh": "五个苹果。"},
        {"en": "How many cats? Two cats.", "zh": "多少只猫？两只猫。"}
      ],
      "quiz": [
        {"question": "How ___ apples?", "options": ["much", "many", "is", "are"], "answer": 1, "explanation": "数可数名词用 many。"},
        {"question": "How many ___?", "options": ["dog", "dogs", "a dog", "is dog"], "answer": 1, "explanation": "How many 后面用复数 dogs。"},
        {"question": "How many cats? — ___ cats.", "options": ["A", "Three", "Cat", "Is"], "answer": 1, "explanation": "回答用数字 + 复数。"},
        {"question": "How many ___ in your bag?", "options": ["book", "books", "a book", "is book"], "answer": 1, "explanation": "How many 后接复数。"},
        {"question": "选出正确的回答：How many fish?", "options": ["Three.", "A fish.", "Fish.", "Yes."], "answer": 0, "explanation": "回答数量用数字。"}
      ]
    },
    {
      "id": "gk-010",
      "title": "What's this? 这是什么",
      "grade": [1, 2],
      "summary": "用 What's this? 问近处的东西，回答用 It's a/an + 名词。",
      "rules": [
        "What's this? = 这是什么？",
        "What's = What is",
        "回答：It's a/an + 名词",
        "It's = It is"
      ],
      "examples": [
        {"en": "What's this? It's a cat.", "zh": "这是什么？是一只猫。"},
        {"en": "What's this? It's an apple.", "zh": "这是什么？是一个苹果。"},
        {"en": "What's this? It's a pen.", "zh": "这是什么？是一支笔。"}
      ],
      "quiz": [
        {"question": "What's ___? — It's a cat.", "options": ["this", "these", "those", "they"], "answer": 0, "explanation": "近处单个用 this。"},
        {"question": "What's this? — ___ a dog.", "options": ["It's", "Its", "It is's", "Is"], "answer": 0, "explanation": "It is 缩写为 It's。"},
        {"question": "What's this? — It's ___ egg.", "options": ["a", "an", "two", "is"], "answer": 1, "explanation": "egg 元音开头用 an。"},
        {"question": "What's this? — It's ___ book.", "options": ["a", "an", "two", "is"], "answer": 0, "explanation": "book 辅音开头用 a。"},
        {"question": "What's = ___", "options": ["What is", "What are", "What it", "Whats"], "answer": 0, "explanation": "What's 是 What is 的缩写。"}
      ]
    },
    {
      "id": "gk-011",
      "title": "Look at... / Listen to... 看/听",
      "grade": [1, 2],
      "summary": "用 Look at + 东西 / Listen to + 声音，让别人看或听。",
      "rules": [
        "Look at + 名词 = 看...",
        "Listen to + 名词 = 听...",
        "这种句子叫祈使句，开头不用主语",
        "请别人时可以加 please"
      ],
      "examples": [
        {"en": "Look at me!", "zh": "看我！"},
        {"en": "Listen to Mom.", "zh": "听妈妈的。"},
        {"en": "Look at the cat.", "zh": "看那只猫。"}
      ],
      "quiz": [
        {"question": "___ at me!", "options": ["Look", "See", "Listen", "Hear"], "answer": 0, "explanation": "看用 Look at。"},
        {"question": "Listen ___ Mom.", "options": ["at", "to", "in", "on"], "answer": 1, "explanation": "Listen 后面用 to。"},
        {"question": "Look ___ the bird.", "options": ["at", "to", "in", "on"], "answer": 0, "explanation": "Look 后面用 at。"},
        {"question": "选出正确的句子", "options": ["Look me at!", "Look at me!", "I look at!", "At look me!"], "answer": 1, "explanation": "正确语序是 Look at + 人。"},
        {"question": "___ to the song.", "options": ["Look", "Listen", "See", "Read"], "answer": 1, "explanation": "听歌用 Listen to。"}
      ]
    },
    {
      "id": "gk-012",
      "title": "Are you...? Yes/No 一般疑问",
      "grade": [1, 2],
      "summary": "用 Are you...? 问对方是不是，回答用 Yes, I am. 或 No, I'm not.",
      "rules": [
        "Are you + 名词/形容词?",
        "Are you Tom? = 你是汤姆吗？",
        "肯定回答：Yes, I am.",
        "否定回答：No, I'm not."
      ],
      "examples": [
        {"en": "Are you Tom? Yes, I am.", "zh": "你是汤姆吗？是的，我是。"},
        {"en": "Are you happy? Yes, I am.", "zh": "你开心吗？是的。"},
        {"en": "Are you six? No, I'm not.", "zh": "你六岁吗？不，我不是。"}
      ],
      "quiz": [
        {"question": "___ you Tom?", "options": ["Am", "Is", "Are", "Be"], "answer": 2, "explanation": "you 后面用 are，疑问句把 are 提前。"},
        {"question": "Are you happy? — Yes, ___.", "options": ["I am", "you are", "I is", "I be"], "answer": 0, "explanation": "肯定回答用 Yes, I am。"},
        {"question": "Are you Lily? — No, ___.", "options": ["I am", "I'm not", "you not", "I not"], "answer": 1, "explanation": "否定回答用 No, I'm not。"},
        {"question": "选正确的疑问句", "options": ["You are Tom?", "Are you Tom?", "Tom you are?", "Is you Tom?"], "answer": 1, "explanation": "疑问句把 Are 放最前。"},
        {"question": "Are you a boy? — ___, I am.", "options": ["Yes", "No", "Not", "I"], "answer": 0, "explanation": "肯定回答用 Yes。"}
      ]
    }
  ]
}
