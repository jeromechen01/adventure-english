  "registration": {
    "title": "报名操作（分步引导）",
    "warnings": [
      "① 教育部考试中心已不再承办 MSE，原 neea 通道作废",
      "② 自 2025 年起剑桥官网关闭个人在线报名通道，改由各城市考点负责 → 不能自己上官网报，必须联系考点"
    ],
    "steps": [
      "进 https://www.cambridgeenglish.cn/ → Find a centre（校园版 https://www.cambridgeenglish.cn/find-a-centre/find-a-schools-centre/ ）",
      "选「考试」→「青少年英语」→ A2 Key for Schools",
      "按 国家 → 省份 → 城市（北京）→ 考试项目 逐级下拉",
      "等约 1 分钟，出现「考场」与「联系人」，点击就近考场联系人",
      "联系考点，确定考期、费用、纸考/机考（参考价：KET ~500 元，PET ~600 元）",
      "提交信息与照片、缴费。姓名与证件信息必须完全一致",
      "准考证考前两周发到报名邮箱，自行下载"
    ],
    "bitingRules": [
      { "item": "报名节奏", "rule": "考前 3 个月开放、考前 2 个月截止", "meaning": "目标 2027 春季（3-4 月）→ 2026 年 12 月起就要联系考点问考期" },
      { "item": "考位", "rule": "北京常年紧张，热门场次秒空", "meaning": "先占位，级别后调" },
      { "item": "转考/退费", "rule": "截止前转考 +20% 手续费；截止后不接受转考及退费；缴费后无法退费", "meaning": "占位成本上限约百元级，值" },
      { "item": "证件", "rule": "大陆考生须用二代居民身份证原件", "meaning": "提前确认有效期" },
      { "item": "考试安排", "rule": "笔试与口语在周六日随机，可能不同天", "meaning": "整个周末留出" },
      { "item": "出分", "rule": "机考约 1-3 周；纸考约 4-6 周", "meaning": "选机考" }
    ],
    "compliance": {
      "title": "合规提示（双减）",
      "lines": [
        "国家及北京规定，校外培训机构不得占用法定节假日、休息日及寒暑假组织学科类培训；2026 年 7 月官方暑期提示进一步明确，暑假期间任何机构或个人面向中小学生的学科类培训——含以「一对一」「住家教师」「托管自习」「思维素养」「夏令营」等名义变相开展的隐形变异培训——均属违规（三重风险：场所安全 / 师资未审 / 资金无监管）。英语属学科类，孩子属义务教育阶段 → 寒暑假只能走自学路线（本方案即按此设计）。",
        "开学后合规窗口：非节假日、非休息日、非寒暑假；线下不晚于 20:30，线上不晚于 21:00 且每课时 ≤30 分钟、间隔 ≥10 分钟；学科类培训人员必须具备教师资格并公示；严禁聘请在境外的外籍人员；收费不得一次性收超 3 个月或 60 课时、单次 ≤5000 元。",
        "选机构四步：查全国校外教育培训监管与服务综合平台白名单 → 查《办学许可证》+营业执照/民非登记证且一址一证 → 用「一码通」或「校外培训家长端 APP」缴费坚决不转个人账户 → 优先「先学后付」（一课一结，机构不得拒绝）。"
      ]
    }
  }
