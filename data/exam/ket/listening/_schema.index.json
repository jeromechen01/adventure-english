{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KET 听力训练营索引",
  "type": "object",
  "required": ["type", "version", "updated", "stages", "lessons"],
  "properties": {
    "type": { "const": "ket-listening" },
    "version": { "type": "string" },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "rules": {
      "type": "object",
      "properties": {
        "maxPlaysMock": { "type": "integer", "minimum": 1, "maximum": 3 },
        "maxPlaysPractice": { "type": "integer", "minimum": 1, "maximum": 5 },
        "vocabCoverageMin": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["stage", "name", "rate", "range"],
        "properties": {
          "stage": { "type": "integer", "minimum": 1, "maximum": 5 },
          "name": { "type": "string", "minLength": 1 },
          "rate": { "enum": [0.8, 0.9, 1] },
          "range": { "type": "string", "pattern": "^L\\d{2}-L\\d{2}$" },
          "desc": { "type": "string" }
        }
      }
    },
    "lessons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "titleZh", "stage", "parts", "questionCount", "file", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^L\\d{2}$" },
          "title": { "type": "string", "minLength": 1 },
          "titleZh": { "type": "string", "minLength": 1 },
          "stage": { "type": "integer", "minimum": 1, "maximum": 5 },
          "parts": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "type": "integer", "minimum": 1, "maximum": 5 } },
          "questionCount": { "type": "integer", "minimum": 1, "maximum": 25 },
          "theme": { "type": "string" },
          "file": { "type": "string", "pattern": "^data/exam/ket/listening/l\\d{2}\\.json$" },
          "status": { "enum": ["ready", "planned"] }
        }
      }
    }
  }
}
