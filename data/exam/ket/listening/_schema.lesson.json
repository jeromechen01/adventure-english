{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KET 听力训练营课文件（lXX.json）",
  "type": "object",
  "required": ["id", "title", "titleZh", "stage", "rate", "parts", "warmup", "sections"],
  "properties": {
    "id": { "type": "string", "pattern": "^L\\d{2}$" },
    "title": { "type": "string", "minLength": 1 },
    "titleZh": { "type": "string", "minLength": 1 },
    "stage": { "type": "integer", "minimum": 1, "maximum": 5 },
    "rate": { "enum": [0.8, 0.9, 1] },
    "parts": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "type": "integer", "minimum": 1, "maximum": 5 } },
    "theme": { "type": "string" },
    "names": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][a-z]+$" } },
    "intro": { "type": "string" },
    "warmup": {
      "type": "array",
      "minItems": 6,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["word", "meaning"],
        "properties": {
          "word": { "type": "string", "pattern": "^[A-Za-zÀ-ÿ][A-Za-zÀ-ÿ' -]*$" },
          "phonetic": { "type": "string", "pattern": "^/.+/$" },
          "meaning": { "type": "string", "pattern": "[\\u4e00-\\u9fff]" }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25,
      "items": { "$ref": "#/definitions/section" }
    }
  },
  "definitions": {
    "turn": {
      "type": "object",
      "required": ["sex", "text"],
      "properties": {
        "who": { "type": "string" },
        "sex": { "enum": ["m", "f"] },
        "text": { "type": "string", "minLength": 2 }
      }
    },
    "section": {
      "type": "object",
      "required": ["id", "part", "script", "questions"],
      "properties": {
        "id": { "type": "string", "pattern": "^s\\d+$" },
        "part": { "type": "integer", "minimum": 1, "maximum": 5 },
        "intro": { "type": "string" },
        "script": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/turn" } },
        "options": { "type": "array", "items": { "type": "string" } },
        "questions": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "$ref": "#/definitions/question" } }
      }
    },
    "question": {
      "type": "object",
      "required": ["id", "q", "answer", "explain"],
      "properties": {
        "id": { "type": "string", "pattern": "^q\\d+$" },
        "q": { "type": "string", "minLength": 2 },
        "options": { "type": "array" },
        "answer": { "type": ["integer", "string"] },
        "alt": { "type": "array", "items": { "type": "string" } },
        "explain": { "type": "string", "pattern": "[\\u4e00-\\u9fff]" }
      }
    }
  }
}
